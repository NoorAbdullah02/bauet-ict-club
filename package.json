{
  "name": "bauet-ict-club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:init": "npm --prefix server run db:init",
    "admin:reset": "npm --prefix server run admin:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
