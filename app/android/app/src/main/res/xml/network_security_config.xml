<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only: allows plain-HTTP to the local API (emulator host 10.0.2.2, LAN IPs). Remove for production (use HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
