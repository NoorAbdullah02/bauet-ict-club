# ============================================================================
#  BAUET ICT Club — environment template
#  Copy this file to `.env` in the project root:   cp .env.example .env
#  Then fill in the values below. `.env` is git-ignored — never commit it.
# ============================================================================

# ---------- REQUIRED ---------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Railway, or a local Postgres).
#   Local example : postgresql://postgres:password@localhost:5432/bauet_ict_club
#   Neon example  : postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/bauet_ict_club

# Secret used to sign admin login tokens. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Password for the first admin account (username: admin). It is created
# automatically the first time the API starts. Change it later with:
#   npm run admin:reset
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------- OPTIONAL ---------------------------------------------------------

# API port and mode
PORT=5000
NODE_ENV=development

# Set to true once, before the first start, to add demo events/notices/awards.
SEED_SAMPLES=false

# Photo hosting (Cloudinary). Leave blank to store uploaded photos on this
# server's disk (server/uploads) instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# AI chatbot (Groq, free key from https://console.groq.com/keys). Leave blank and the chat still answers from your FAQ, events and committee.
GROQ_API_KEY=
# Optional: a Groq model id to try first. Groq retires models; if it is gone the server tries openai/gpt-oss-120b, openai/gpt-oss-20b and qwen/qwen3.8-27b by itself.
GROQ_MODEL=openai/gpt-oss-120b

# --- Security / deployment ---
# Extra browser origins allowed to call the API (comma separated), e.g. a separately hosted site. Same-origin and the mobile app need nothing.
CORS_ORIGINS=
# Set to 1 when the server runs behind a proxy (Render, Railway, Nginx) so rate limits see the real visitor IP
TRUST_PROXY=
# Public website address (used in sitemap.xml), e.g. https://bauet-ict-club.example.com
PUBLIC_URL=

# --- Email (optional but recommended) ---
# Recommended: Brevo API (free plan, 300 mails/day). Create a key at https://app.brevo.com/settings/keys/api,
# then add and verify your sender address under Senders & IP > Senders.
BREVO_API_KEY=
# The verified sender address shown in the From line. Required for Brevo.
MAIL_FROM=
# Where new-application and contact-form alerts and exports are sent
ADMIN_NOTIFY_EMAIL=
# Alternative when no Brevo key is set: SMTP (e.g. a Gmail account with an "App password")
SMTP_USER=
SMTP_PASS=
# Defaults to smtp.gmail.com:465. Change only for another SMTP provider.
SMTP_HOST=
SMTP_PORT=

# Email every subscriber automatically when you add a new event, notice or project (set to false to turn it off)
NOTIFY_SUBSCRIBERS=true

# Visitor IP addresses are deleted after this many days (default 180)
ANALYTICS_RETENTION_DAYS=180

# Day-before reminder emails to people registered for an event (set to false to turn off)
EVENT_REMINDERS=true

# Optional: lets a free cron service (cron-job.org) wake the server and run reminders. Use 16+ random characters, then call  GET /api/jobs/run?key=THIS_VALUE  every 10-15 minutes.
CRON_SECRET=

# --- Phone notifications (optional) ---
# The service-account .json from Firebase (Project settings > Service accounts > Generate new private key), pasted as it is or as base64.
# SECRET: never commit it. Without it no notification is sent. See docs/PUSH_NOTIFICATIONS.md
FIREBASE_SERVICE_ACCOUNT=
# Set to false to stop sending notifications without removing the key
PUSH_ENABLED=

# --- Instant Admin Alerts (Telegram & Discord, optional) ---
# For Telegram: create a bot with @BotFather, get bot token, and get your chat/channel ID (or group ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# For Discord: Server settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
