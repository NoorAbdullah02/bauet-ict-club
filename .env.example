# ============================================================================
#  BAUET ICT Club — environment template
#  Copy this file to `.env` in the project root:   cp .env.example .env
#  Then fill in the values below. `.env` is git-ignored — never commit it.
# ============================================================================

# ---------- REQUIRED ---------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Railway, or a local Postgres).
#   Local example : postgresql://postgres:password@localhost:5432/bauet_ict_club
#   Neon example  : postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/bauet_ict_club

# Secret used to sign admin login tokens. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Password for the first admin account (username: admin). It is created
# automatically the first time the API starts. Change it later with:
#   npm run admin:reset
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------- OPTIONAL ---------------------------------------------------------

# API port and mode
PORT=5000
NODE_ENV=development

# Set to true once, before the first start, to add demo events/notices/awards.
SEED_SAMPLES=false

# Photo hosting (Cloudinary). Leave blank to store uploaded photos on this
# server's disk (server/uploads) instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# AI chatbot (Groq, free key from https://console.groq.com/keys). Leave blank and the chat still answers from your FAQ, events and committee.
GROQ_API_KEY=
# Optional: another Groq model id
GROQ_MODEL=llama-3.3-70b-versatile

# --- Security / deployment ---
# Extra browser origins allowed to call the API (comma separated), e.g. a separately hosted site. Same-origin and the mobile app need nothing.
CORS_ORIGINS=
# Set to 1 when the server runs behind a proxy (Render, Railway, Nginx) so rate limits see the real visitor IP
TRUST_PROXY=
# Public website address (used in sitemap.xml), e.g. https://bauet-ict-club.example.com
PUBLIC_URL=

# --- Email (optional but recommended) ---
# Easiest: a Gmail account with 2-step verification + an "App password"
#   (Google Account > Security > App passwords). Use that 16-letter password, NOT your normal one.
SMTP_USER=
SMTP_PASS=
# Defaults to smtp.gmail.com:465. Change only for another provider.
SMTP_HOST=
SMTP_PORT=
# Shown as the sender (defaults to SMTP_USER) and where new-application / contact alerts are sent
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Alternative to SMTP: Brevo API key (MAIL_FROM must be a sender verified in Brevo)
BREVO_API_KEY=

# Email every subscriber automatically when you add a new event, notice or project (set to false to turn it off)
NOTIFY_SUBSCRIBERS=true
