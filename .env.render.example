# Paste these into Render -> your service -> Environment (the first four are already in render.yaml).
# Nothing here is a real secret; fill the empty ones with your own values.

NODE_ENV=production
TRUST_PROXY=1
NODE_VERSION=20
JWT_SECRET=                 # Render can generate it (render.yaml does); otherwise 32+ random characters

# Database (Neon): copy the connection string, it ends with ?sslmode=require
DATABASE_URL=

# Admin login: username is "admin"
ADMIN_PASSWORD=             # 12+ characters

# Website address: leave empty. Render provides RENDER_EXTERNAL_URL and the server uses it.
# Only set PUBLIC_URL if you attach your own domain, for example https://bauetictclub.org
PUBLIC_URL=

# Email (Brevo API)
BREVO_API_KEY=
MAIL_FROM=                  # a sender you verified in Brevo
ADMIN_NOTIFY_EMAIL=

# Pictures (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant (optional)
GROQ_API_KEY=
